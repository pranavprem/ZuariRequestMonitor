# Copy to .env and fill in locally. .env is gitignored.

# iNotify Process Execution site. Required for a live check.
INOTIFY_URL=
INOTIFY_USERNAME=
INOTIFY_PASSWORD=

# Mail. Defaults match the original Gmail STARTTLS setup.
# ALERT_TO can list several addresses, separated by commas.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_FROM=
ALERT_TO=

# A count alerts only when it is strictly greater than this value.
ALERT_THRESHOLD=50
# Seconds between live polls. The 2013 loop had no delay; the default is five minutes.
POLL_INTERVAL_SECONDS=300
